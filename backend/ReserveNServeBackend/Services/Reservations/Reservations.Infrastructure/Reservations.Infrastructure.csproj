<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

      <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
      <PackageReference Include="Google.Protobuf" Version="3.31.1" />

      <PackageReference Include="Grpc.Tools" Version="2.83.0">
          <PrivateAssets>All</PrivateAssets>
      </PackageReference>

      <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Reservations.Application\Reservations.Application.csproj" />
      <ProjectReference Include="..\Reservations.Domain\Reservations.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos/restaurants.proto" GrpcServices="Client" />
        <Protobuf Include="Protos/payment.proto" GrpcServices="Client" />
    </ItemGroup>

</Project>
