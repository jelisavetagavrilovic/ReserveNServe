FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci


FROM node:22-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_RESERVATIONS_API_URL
ARG NEXT_PUBLIC_RESTAURANTS_API_URL
ARG NEXT_PUBLIC_IDENTITY_API_URL

ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_RESERVATIONS_API_URL=$NEXT_PUBLIC_RESERVATIONS_API_URL
ENV NEXT_PUBLIC_RESTAURANTS_API_URL=$NEXT_PUBLIC_RESTAURANTS_API_URL
ENV NEXT_PUBLIC_IDENTITY_API_URL=$NEXT_PUBLIC_IDENTITY_API_URL

RUN npm run build


FROM node:22-alpine AS final

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=build /app ./

RUN npm prune --omit=dev

EXPOSE 3000

CMD ["npm", "run", "start"]